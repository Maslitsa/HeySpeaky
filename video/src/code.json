["import React, { useEffect, useState } from \"react\";", "import { AbsoluteFill, continueRender, delayRender, spring, useCurrentFrame } from \"remotion\";", "import { fontsReady, INTER, SERIF } from \"./fonts\";", "import { C, clamp, FPS, hexA, LANG, Lang } from \"./theme\";", "/** Seconds into the film, inside a scene that began at `start`. */", "export const useT = (start: number) => start + useCurrentFrame() / FPS;", "/** 0 before `at`, then a spring to 1. */", "/** 0 before `at`, 1 after `at + length`, eased out in between. */", "export const easeAt = (t: number, at: number, length = 0.4) => {", "  const p = clamp((t - at) / length);", "  return 1 - Math.pow(1 - p, 3);", "};", "export const easeInOut = (p: number) => {", "  p = clamp(p);", "  return p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;", "};", "// -- type ---------------------------------------------------------------------", "  fontFamily: INTER,", "  fontWeight: weight,", "  fontSize: size,", "  color,", "  letterSpacing: -size * 0.03,", "  lineHeight: 1.05,", "});", "export const accent = (size: number, color: string = C.red): React.CSSProperties => ({", "  fontFamily: SERIF,", "  fontStyle: \"italic\",", "  fontWeight: 400,", "  fontSize: size,", "  color,", "  letterSpacing: -size * 0.01,", "  lineHeight: 1.0,", "});", "/** A word that arrives when it is said: up, sharp and out of a blur. */", "  t,", "  at,", "  style,", "  children,", "  rise = 46,", "}) => {", "  const p = springAt(t, at, { damping: 13, mass: 0.6, stiffness: 190 });", "  return (", "    <span", "      style={{", "        display: \"inline-block\",", "        opacity: clamp(p * 1.4),", "        transform: `translateY(${(1 - p) * rise}px) scale(${0.9 + 0.1 * p})`,", "        filter: `blur(${(1 - clamp(p)) * 10}px)`,", "        whiteSpace: \"pre\",", "        ...style,", "      }}", "    >", "      {children}", "    </span>", "  );", "};", "// -- backgrounds --------------------------------------------------------------", "// Soft colour far behind, and small glossy beads drifting nearer: depth, so", "// the page never reads as a flat slide. One colour per language.", "const BEADS = [", "  { x: 180, y: 820, r: 26, c: LANG.kk.color, s: 0.7 },", "  { x: 1760, y: 180, r: 18, c: LANG.en.color, s: 1.1 },", "  { x: 1650, y: 930, r: 34, c: LANG.ru.color, s: 0.5 },", "  { x: 90, y: 260, r: 14, c: LANG.de.color, s: 1.3 },", "  { x: 1150, y: 980, r: 12, c: LANG.kk.color, s: 0.9 },", "  { x: 860, y: 70, r: 10, c: LANG.ru.color, s: 1.2 },", "];", "const HAZE = [", "  { x: 260, y: 300, r: 520, c: LANG.en.color },", "  { x: 1700, y: 800, r: 620, c: LANG.ru.color },", "  { x: 1500, y: 160, r: 420, c: LANG.kk.color },", "];", "  const t = useCurrentFrame() / FPS;", "  return (", "    <AbsoluteFill", "      style={{", "      }}", "    >", "      {HAZE.map((h, i) => (", "        <div", "          key={`h${i}`}", "          style={{", "            position: \"absolute\",", "            left: h.x - h.r + Math.sin(t * 0.3 + i) * 40,", "            top: h.y - h.r + Math.cos(t * 0.25 + i * 2) * 30,", "            width: h.r * 2,", "            height: h.r * 2,", "            borderRadius: \"50%\",", "            background: `radial-gradient(circle, ${hexA(h.c, 0.09)} 0%, ${hexA(h.c, 0)} 70%)`,", "          }}", "        />", "      ))}", "      {BEADS.map((b, i) => (", "        <div", "          key={`b${i}`}", "          style={{", "            position: \"absolute\",", "            left: b.x + Math.sin(t * 0.6 * b.s + i * 1.7) * 30,", "            top: b.y + Math.cos(t * 0.5 * b.s + i) * 24 - t * 12 * b.s,", "            width: b.r * 2,", "            height: b.r * 2,", "            borderRadius: \"50%\",", "            boxShadow: `0 ${b.r * 0.5}px ${b.r}px ${hexA(b.c, 0.25)}`,", "            filter: b.r < 16 ? \"blur(1.5px)\" : undefined,", "            opacity: 0.8,", "          }}", "        />", "      ))}", "      {children}", "    </AbsoluteFill>", "  );", "};", "/** Each shot arrives out of a blur and a little too close, over the last. */", "  const frame = useCurrentFrame();", "  const p = clamp(frame / (length * FPS));", "  const e = 1 - Math.pow(1 - p, 3);", "  if (p >= 1) return <AbsoluteFill>{children}</AbsoluteFill>;", "  return (", "  );", "};", ");", "// -- Speaky -------------------------------------------------------------------", "export type Mood = \"idle\" | \"talking\" | \"listening\" | \"thinking\" | \"happy\";", "/** heyspeaky/glass.py mono_heights, line for line: the real pill's bars. */", "  const out: number[] = [];", "  level = clamp(level);", "  const middle = (count - 1) / 2;", "  for (let i = 0; i < count; i++) {", "    let share: number;", "    if (state === \"listening\") {", "      const drift = 0.35 * Math.sin(now * 1.7 + i * 0.9);", "      const bell = Math.exp(-Math.pow((i - middle - drift) / 1.9, 2));", "      const pulse = 0.5 + 0.5 * Math.sin(now * (5.3 + i * 0.7) + i * 1.9);", "      share = level * bell * (0.82 + 0.18 * pulse) + 0.14 * pulse * (0.35 + 0.65 * level);", "    } else {", "      const wave = 0.5 + 0.5 * Math.sin(now * 2 * Math.PI * 1.6 - i * 0.75);", "      share = 0.3 + 0.7 * wave;", "    }", "    out.push(clamp(share));", "  }", "  return out;", "};", "/**", " * The Mono pill with eyes. The capsule is the app's own - 108 by 58, its", " * black, its eight bars - and the bars are its mouth: red while it listens", " * or talks, a blue wave while it thinks, grey while it waits.", " */", "export const Speaky: React.FC<{", "  width: number;", "  mood: Mood;", "  t: number;", "  level?: number;", "  blink?: number;", "  wink?: number;", "  look?: [number, number];", "  squash?: number;", "  eyeScale?: number;", "  style?: React.CSSProperties;", "  const w = width;", "  const h = w / 1.862;", "  const room = h * 0.42;", "  const top = room;", "  const cx = w / 2;", "  const cy = top + h / 2;", "  const still = mood === \"idle\" || mood === \"happy\";", "  const k = h / 58;", "  const barW = 4.6 * k;", "  const pitch = 9.4 * k;", "  const minH = 8.0 * k;", "  const maxH = 26 * k;", "  const barColor = mood === \"thinking\" ? C.blueLit : still ? \"#5B5560\" : C.red;", "  const glow = mood === \"thinking\" ? C.blue : still ? \"transparent\" : C.red;", "  const first = cx - pitch * 3.5;", "  const id = `s${Math.round(w)}`;", "  const r = h * 0.27 * eyeScale;", "  const eyes = [cx - w * 0.2, cx + w * 0.2];", "  const eyeY = top + h * 0.04;", "  const blinkFor = (side: number) => clamp(blink + (side === 1 ? wink : 0));", "  return (", "    <svg", "      width={w}", "      height={h + room + h * 0.3}", "      viewBox={`0 0 ${w} ${h + room + h * 0.3}`}", "      style={{", "        overflow: \"visible\",", "        transform: `scale(${1 + squash * 0.14}, ${1 - squash * 0.14})`,", "        transformOrigin: \"50% 85%\",", "        ...style,", "      }}", "    >", "      <defs>", "        <filter id={`${id}glow`} x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">", "          <feGaussianBlur stdDeviation={2.6 * k} />", "        </filter>", "        <filter id={`${id}soft`} x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">", "          <feGaussianBlur stdDeviation={h * 0.09} />", "        </filter>", "        <linearGradient id={`${id}sheen`} x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">", "          <stop offset=\"0\" stopColor=\"#FFFFFF\" stopOpacity=\"0.13\" />", "          <stop offset=\"0.45\" stopColor=\"#FFFFFF\" stopOpacity=\"0\" />", "        </linearGradient>", "      </defs>", "      <rect x={0} y={top} width={w} height={h} rx={h / 2} fill={C.mono} />", "      <g filter={`url(#${id}glow)`} opacity={0.55}>", "        {heights.map((s, i) => {", "          const bh = minH + (maxH - minH) * s;", "        })}", "      </g>", "      {heights.map((s, i) => {", "        const bh = minH + (maxH - minH) * s;", "      })}", "      {eyes.map((ex, side) => {", "        const shut = blinkFor(side);", "        if (mood === \"happy\" && shut < 0.5) {", "          // Smiling eyes: closed arcs, the way a pleased face squints.", "          return (", "            <g key={side}>", "              <path", "                stroke={C.mono}", "                strokeWidth={h * 0.07}", "                strokeLinecap=\"round\"", "                fill=\"none\"", "              />", "            </g>", "          );", "        }", "        const ry = r * (1 - shut * 0.92);", "        return (", "          <g key={side}>", "            {shut < 0.6 && (", "              <circle", "                cx={ex + look[0] * r * 0.38}", "                cy={eyeY + look[1] * r * 0.38 * (1 - shut)}", "                r={r * 0.46 * (1 - shut * 0.5)}", "                fill={C.mono}", "              />", "            )}", "          </g>", "        );", "      })}", "    </svg>", "  );", "};", "/** A blink, 0 to 1 and back, around `at`. */", "export const blinkAt = (t: number, at: number, length = 0.14) => {", "  const d = Math.abs(t - at);", "  return d > length / 2 ? 0 : 1 - d / (length / 2);", "};", "// -- keys -----------------------------------------------------------------------", "/** A keycap seen from the front: its top drops into its lip when pressed. */", "  const w = size * (label.length > 3 ? 1.3 : 1.05);", "  const h = size * 0.8;", "  const lip = size * 0.1;", "  const drop = lip * 0.8 * press;", "  const radius = size * 0.17;", "  return (", "    <div style={{ position: \"relative\", width: w, height: h + lip, ...style }}>", "      <div", "        style={{", "          position: \"absolute\","]