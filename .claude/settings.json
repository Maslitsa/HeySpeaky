{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/precommit.py",
            "timeout": 180,
            "statusMessage": "Checking the commit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/session_brief.py",
            "timeout": 30,
            "statusMessage": "Reading the app's log"
          }
        ]
      }
    ]
  }
}
