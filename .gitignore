# ---------------------------------------------------------------------------
# Secrets. Nothing here should ever reach a commit.
#
# HeySpeaky keeps the OpenAI key in %APPDATA%\HeySpeaky\openai.key, outside
# the project, precisely so it cannot be committed by accident. These rules
# are the second line of defence for anyone who puts one here anyway.
# ---------------------------------------------------------------------------
*.key
*.pem
.env
.env.*
secrets.json
openai.key

# Local settings. Written on first run from the defaults in
# heyspeaky/config.py, and it has an api_key field, so it stays untracked.
config.json

# ---------------------------------------------------------------------------
# Local state
# ---------------------------------------------------------------------------
logs/
*.log

# Upstream RealtimeSTT clone, if you keep one here for reference.
# HeySpeaky installs it from PyPI; this is not part of the project.
RealtimeSTT-repo/

# Your own working notes. Drafts, worklogs, anything you do not want published.
# Everything in here stays on your machine.
notes/
scratch/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# The installer keeps uv, its Python and its download cache here.
.uv/

# Problem reports hold recordings of your voice. They never belong in git.
*-report-*.zip

# Drawn by the installer from tools/make_icon.py, not kept here.
heyspeaky.ico
